# Ottieni la chiave su https://aistudio.google.com/apikey
GEMINI_API_KEY=inserisci_qui_la_tua_chiave

# API Key per la ricerca in tempo reale su Normattiva/Gazzetta Ufficiale (RAG).
# Ottieni la chiave su https://tavily.com
TAVILY_API_KEY=inserisci_qui_la_tua_chiave

# API Key per Groq (Qwen 3.8 27B) come validatore anti-allucinazione.
# Ottieni la chiave su https://console.groq.com/keys
GROQ_API_KEY=inserisci_qui_la_tua_chiave

# API Key per OpenRouter (fallback estremo quando Gemini e Groq sono saturi).
# Ottieni la chiave su https://openrouter.ai/keys
OPENROUTER_API_KEY=inserisci_qui_la_tua_chiave

# API Key per NVIDIA NIM (fallback potente, ultima risorsa).
# Ottieni la chiave su https://build.nvidia.com
NVIDIA_API_KEY=inserisci_qui_la_tua_chiave

# --- Opzionali: notifiche di watchdog e audit settimanale dei modelli ---
# Webhook generico (Discord/Slack) e/o Telegram. Se assenti, nessuna notifica.
WATCHDOG_WEBHOOK_URL=
WATCHDOG_TELEGRAM_TOKEN=
WATCHDOG_TELEGRAM_CHAT_ID=
# Protegge /api/watchdog quando esposto pubblicamente.
WATCHDOG_TOKEN=
# Sovrascrive il modello NVIDIA di default (ha precedenza su lib/ai-models.mjs).
NVIDIA_MODEL=
